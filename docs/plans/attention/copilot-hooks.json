{
  "hooks": {
    "agentStop": [
      {
        "powershell": "& 'C:\\folio\\folio.exe' attention copilot:agentStop",
        "timeoutSec": 5,
        "type": "command"
      }
    ],
    "notification": [
      {
        "matcher": "permission_prompt",
        "powershell": "& 'C:\\folio\\folio.exe' attention copilot:notification.permission_prompt",
        "timeoutSec": 5,
        "type": "command"
      },
      {
        "matcher": "elicitation_dialog",
        "powershell": "& 'C:\\folio\\folio.exe' attention copilot:notification.elicitation_dialog",
        "timeoutSec": 5,
        "type": "command"
      }
    ],
    "sessionEnd": [
      {
        "powershell": "& 'C:\\folio\\folio.exe' attention copilot:sessionEnd",
        "timeoutSec": 5,
        "type": "command"
      }
    ],
    "userPromptSubmitted": [
      {
        "powershell": "& 'C:\\folio\\folio.exe' attention copilot:userPromptSubmitted",
        "timeoutSec": 5,
        "type": "command"
      }
    ]
  },
  "version": 1
}
