{
  "hooks": {
    "agentStop": [
      {
        "args": [
          "attention",
          "copilot:agentStop"
        ],
        "exec": "C:\\folio\\folio.exe",
        "timeoutSec": 5,
        "type": "command"
      }
    ],
    "notification": [
      {
        "args": [
          "attention",
          "copilot:notification.permission_prompt"
        ],
        "exec": "C:\\folio\\folio.exe",
        "matcher": "permission_prompt",
        "timeoutSec": 5,
        "type": "command"
      },
      {
        "args": [
          "attention",
          "copilot:notification.elicitation_dialog"
        ],
        "exec": "C:\\folio\\folio.exe",
        "matcher": "elicitation_dialog",
        "timeoutSec": 5,
        "type": "command"
      }
    ],
    "sessionEnd": [
      {
        "args": [
          "attention",
          "copilot:sessionEnd"
        ],
        "exec": "C:\\folio\\folio.exe",
        "timeoutSec": 5,
        "type": "command"
      }
    ],
    "userPromptSubmitted": [
      {
        "args": [
          "attention",
          "copilot:userPromptSubmitted"
        ],
        "exec": "C:\\folio\\folio.exe",
        "timeoutSec": 5,
        "type": "command"
      }
    ]
  },
  "version": 1
}
